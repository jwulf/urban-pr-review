{
  "name": "@nanobpm/urban-pr-review",
  "version": "0.21.0",
  "description": "Nano Urban app that drives GitHub pull requests to convergence against an automated reviewer, one durable multi-round loop per PR.",
  "type": "module",
  "main": "main.ts",
  "engines": {
    "node": ">=22.6"
  },
  "author": "Josh Wulf <josh.wulf@camunda.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/jwulf/urban-pr-review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwulf/urban-pr-review.git"
  },
  "bugs": {
    "url": "https://github.com/jwulf/urban-pr-review/issues"
  },
  "keywords": [
    "nano-ide-ext",
    "nano-ide-agentic-sdlc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node --experimental-strip-types main.ts",
    "purge": "node --experimental-strip-types scripts/purge-db.ts",
    "upgrade": "node --experimental-strip-types scripts/upgrade-from-pack.ts",
    "check": "urban check",
    "typecheck": "tsc --noEmit",
    "check:prompts": "deno run -A scripts/check-agent-prompts.ts",
    "gen": "urban gen",
    "gen:check": "urban gen --check",
    "layout": "node --experimental-strip-types scripts/layout-bpmn.ts",
    "dev": "urban dev",
    "compile": "deno task compile",
    "test": "deno test -A"
  },
  "dependencies": {
    "@nanobpm/urban": "^0.23.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^22",
    "semantic-release": "^24.2.9",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@semantic-release/npm": "^13.1.5"
  }
}
