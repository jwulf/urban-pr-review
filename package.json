{
  "name": "@nanobpm/urban-pr-review",
  "version": "0.2.1",
  "description": "Nano Urban app that drives GitHub pull requests to convergence against an automated reviewer, one durable multi-round loop per PR.",
  "type": "module",
  "main": "main.ts",
  "engines": {
    "node": ">=22.6"
  },
  "author": "Josh Wulf <josh.wulf@camunda.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/jwulf/urban-pr-review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwulf/urban-pr-review.git"
  },
  "bugs": {
    "url": "https://github.com/jwulf/urban-pr-review/issues"
  },
  "keywords": [
    "nano-ide-ext",
    "nano-ide-agentic-sdlc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node --experimental-strip-types main.ts",
    "purge": "node --experimental-strip-types scripts/purge-db.ts",
    "compile": "deno task compile"
  },
  "dependencies": {
    "@nanobpm/urban": "^0.11.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22",
    "semantic-release": "^24.2.9",
    "@semantic-release/npm": "^13.1.5"
  },
  "overrides": {
    "@semantic-release/npm": "^13.1.5"
  }
}
