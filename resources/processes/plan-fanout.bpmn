        <di:waypoint x="1216" y="420" />
        <di:waypoint x="1216" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1837" y="428" width="35" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
