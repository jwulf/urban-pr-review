{
  "$schema": "https://nanobpm.io/spec-app/nano-app.schema.json",
  "schemaVersion": 1,
  "id": "urban-pr-review",
  "name": "PR Review Convergence",
  "codename": "urban-pr-review",
  "models": {
    "processes": [
      "resources/processes/*.bpmn"
    ]
  },
  "data": {
    "default": "app",
    "sources": {
      "app": {
        "driver": "sqlite",
        "url": "${NANO_APP_DB_URL:-file:./app.db}",
        "migrations": "db/migrations"
      }
    }
  },
  "workers": [
    {
      "taskType": "pr.persist-round",
      "handler": "workers/persist-round/worker.ts"
    },
    {
      "taskType": "pr.persist-escalation",
      "handler": "workers/persist-escalation/worker.ts"
    },
    {
      "taskType": "pr.finalize",
      "handler": "workers/finalize/worker.ts"
    },
    {
      "taskType": "senior:pr-review"
    }
  ],
  "types": {
    "PrReviewRoundIn": {
      "name": "PR review round — input",
      "fields": {
        "prUrl": { "type": "string" },
        "repo": { "type": "string" },
        "prNumber": { "type": "integer" },
        "prompt": { "type": "string" },
        "round": { "type": "integer" },
        "answer": { "type": "string", "optional": true }
      }
    },
    "PrReviewRoundOut": {
      "name": "PR review round — result",
      "fields": {
        "status": { "type": "string" },
        "summary": { "type": "string" },
        "question": { "type": "string", "optional": true }
      }
    },
    "PrPersistRoundIn": {
      "name": "Record round — input",
      "fields": {
        "prKey": { "type": "string" },
        "round": { "type": "integer" },
        "status": { "type": "string", "optional": true },
        "summary": { "type": "string", "optional": true }
      }
    },
    "PrPersistEscalationIn": {
      "name": "Record escalation — input",
      "fields": {
        "prKey": { "type": "string" },
        "round": { "type": "integer" },
        "status": { "type": "string", "optional": true },
        "summary": { "type": "string", "optional": true },
        "question": { "type": "string", "optional": true }
      }
    },
    "PrPersistEscalationOut": {
      "name": "Record escalation — result",
      "fields": {
        "escalationId": { "type": "integer" }
      }
    },
    "PrFinalizeIn": {
      "name": "Mark converged — input",
      "fields": {
        "prKey": { "type": "string" },
        "round": { "type": "integer" },
        "summary": { "type": "string", "optional": true }
      }
    },
    "ReviewReady": {
      "name": "review-ready message payload",
      "fields": {
        "reviewId": { "type": "integer" },
        "reviewState": { "type": "string" },
        "submittedAt": { "type": "datetime", "optional": true }
      }
    },
    "EscalationAnswered": {
      "name": "escalation-answered message payload",
      "fields": {
        "answer": { "type": "string" },
        "escalationId": { "type": "integer" }
      }
    }
  }
}
